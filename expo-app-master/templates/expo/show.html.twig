{% extends 'base.html.twig' %}

{% block title %}Expo{% endblock %}

{% block body %}
    <h1>Expo</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ expo.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ expo.name }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ expo.image }}</td>
            </tr>
            <tr>
                <th>StartDate</th>
                <td>{{ expo.startDate ? expo.startDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>EndDate</th>
                <td>{{ expo.endDate ? expo.endDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ expo.description }}</td>
            </tr>
            <tr>
                <th>Location</th>
                <td>{{ expo.location }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ expo.price }}</td>
            </tr>
            <tr>
                <th>Published</th>
                <td>{{ expo.published ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ expo.createdAt ? expo.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ expo.updatedAt ? expo.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Author</th>
                <td>{{ expo.author }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_expo_index') }}">back to list</a>

    <a href="{{ path('app_expo_edit', {'id': expo.id}) }}">edit</a>

    {{ include('expo/_delete_form.html.twig') }}
{% endblock %}
